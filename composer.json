{
  "name": "laravel-tipi/support",
  "description": "Shared support utilities for Laravel Tipi packages",
  "keywords": [
    "laravel",
    "support",
    "utilities"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Irakli",
      "email": "iraklikevkhishvili@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "illuminate/validation": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.32",
    "orchestra/testbench": "^11.3",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Tipi\\Support\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tipi\\Support\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "pest",
    "format": "pint",
    "format:test": "pint --test",
    "check": [
      "@format:test",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "support": {
    "issues": "https://github.com/laravel-tipi/support/issues",
    "source": "https://github.com/laravel-tipi/support"
  }
}